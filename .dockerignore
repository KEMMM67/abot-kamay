# .dockerignore (build context: the repository root, for apps/api/Dockerfile)
# Keep the context small and never send secrets or local build output to the builder.

**/node_modules
**/dist
**/coverage
**/.next
**/*.tsbuildinfo
**/*.log
.git
.github
.vscode
.idea

# Secrets never enter an image; Render and Railway inject environment variables at runtime.
**/.env
**/.env.*

# Regenerated by `prisma generate` during the build.
apps/api/src/generated

# The web app deploys to Vercel; npm ci only needs its manifest.
apps/web/*
!apps/web/package.json

# Not part of the API image.
qa
brand
TECHNICAL_PLAN.md
README.md
DEPLOYMENT.md
apps/api/test
apps/api/**/*.spec.ts
