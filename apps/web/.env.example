# apps/web/.env.example: copy to apps/web/.env.local. Next.js reads env files from this folder,
# not from the repository root. Every NEXT_PUBLIC_ value is inlined into the browser bundle at
# build time, so never put a secret here. There is no sample-data mode: every page reads the API.
# On Vercel, set these in Project Settings > Environment Variables (see DEPLOYMENT.md).

# AbotKamay API, including the version prefix (the NestJS app in apps/api).
# Production: https://api.abotkamay.ph/api/v1 (or https://<service>.onrender.com/api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Public origin of this site: canonical URLs, share links, /c/{slug} short links, Open Graph metadata.
# On Vercel it falls back to the production domain when unset, but set it explicitly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Media CDN origin for moderated post photos, videos and video posters (Content Security Policy
# img-src/media-src and next/image remote patterns). Must match the API's MEDIA_PUBLIC_BASE_URL,
# e.g. https://media.abotkamay.ph (an R2 custom domain or a CloudFront distribution).
NEXT_PUBLIC_MEDIA_BASE_URL=

# Server-only (no NEXT_PUBLIC_ prefix, never sent to browsers). The same value as the API's
# FORWARDED_IP_SECRET: Server Actions report each visitor's IP address to the API with it, for the
# per-IP sign-in limit and audit records. Leave empty in development (the API then sees this server).
FORWARDED_IP_SECRET=

# Storage origins that browsers upload to directly with presigned URLs (CSP connect-src), space- or
# comma-separated. Cloudflare R2 (one account endpoint for every bucket):
#   https://<account-id>.r2.cloudflarestorage.com
# AWS S3 (virtual-hosted style, one origin per bucket):
#   https://abotkamay-quarantine.s3.ap-southeast-1.amazonaws.com https://abotkamay-restricted.s3.ap-southeast-1.amazonaws.com
NEXT_PUBLIC_UPLOAD_ORIGINS=
