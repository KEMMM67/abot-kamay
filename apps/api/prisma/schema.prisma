// apps/api/prisma/schema.prisma
//
// AbotKamay core data model (Prisma ORM 7, PostgreSQL on Neon).
//
// Conventions
// - Tables and columns are snake_case in PostgreSQL (@@map / @map); models stay PascalCase in code.
// - Primary keys are UUIDv7 (time-ordered, index-friendly), generated by Prisma Client.
// - Money is ALWAYS an integer amount in minor units (centavos) + ISO 4217 currency. Never floats.
// - The ledger is the source of truth for balances; Campaign.raisedMinor is a read projection.
// - Beneficiary PII lives only in beneficiary_private (application-level envelope encryption).
// - Guarantees Prisma cannot express (append-only triggers, balanced double-entry check, four-eyes
//   and maker-checker CHECKs, one-open-campaign partial index) live in the SQL migration
//   prisma/migrations/20260925000100_ledger_guarantees. Never remove them.
//
// Creator-led model (migration 20260925000200_creator_posts_kyc)
// - A campaign is a post: a KYC-verified user (the creator) uploads photos/videos of a person in need
//   with a caption. Unverified users can only browse and donate.
// - The KYC front gate is enforced twice: by the API, and by database triggers that reject a campaign
//   whose creator is not VERIFIED and a creator payout to anyone but the verified creator.
// - Funding is FIXED (an exact goal, e.g. a hospital bill) or OPEN_ENDED (no goal, e.g. groceries).
// - Creators post their own proof of spending (receipts, item photos) as spending_reports. The facts
//   in a report can never be edited or deleted, and reports are hash-chained per campaign.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the driver adapter (runtime).
}

// =====================================================================
// Enums
// =====================================================================

enum Role {
  DONOR
  SUBMITTER
  COORDINATOR
  ORG_ADMIN
  REVIEWER
  FINANCE
  ADMIN
  AUDITOR

  @@map("role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED

  @@map("account_status")
}

// Identity verification state of a user. Only VERIFIED users may create posts or receive funds.
enum KycStatus {
  UNVERIFIED // default: can browse and donate only
  PENDING_ID // government ID and selfie submitted, waiting for a reviewer
  VERIFIED // may create posts and receive payouts until kyc_expires_at
  REJECTED // the last attempt failed; the user may submit again
  EXPIRED // verification lapsed (ID expired or re-verification due): posting and payouts stop
  REVOKED // withdrawn after fraud or a substantiated complaint; only staff can restore it

  @@map("kyc_status")
}

// One identity check attempt. A user has at most one SUBMITTED attempt at a time (partial index).
enum IdentityCheckStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN // superseded or cancelled before a decision

  @@map("identity_check_status")
}

// Government photo IDs accepted for creator verification.
enum GovernmentIdType {
  PHILSYS // PhilID or ePhilID (national ID)
  PASSPORT
  DRIVERS_LICENSE
  UMID
  SSS
  PRC
  POSTAL
  VOTERS

  @@map("government_id_type")
}

enum KycDocumentKind {
  ID_FRONT
  ID_BACK
  SELFIE_WITH_ID // selfie holding the ID and a paper with the one-time challenge code

  @@map("kyc_document_kind")
}

enum CoordinatorTier {
  TIER0_REGISTERED
  TIER1_IDENTITY
  TIER2_FIELD
  TIER3_ORG_BACKED
  TIER4_TRUSTED

  @@map("coordinator_tier")
}

enum Platform {
  TIKTOK
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  X
  OTHER

  @@map("platform")
}

enum SubmissionStatus {
  RECEIVED
  AUTO_REJECTED
  DUPLICATE
  NEEDS_TRIAGE
  NEEDS_INFO
  VERIFICATION_OPENED
  REJECTED
  CONVERTED

  @@map("submission_status")
}

enum VerificationStatus {
  OPEN
  ASSIGNED
  FIELD_VISIT_DONE
  IN_REVIEW
  APPROVED
  REJECTED
  UNVERIFIABLE
  DECLINED_BY_BENEFICIARY

  @@map("verification_status")
}

enum BeneficiaryStatus {
  ACTIVE
  WITHDRAWN
  DECEASED
  MERGED

  @@map("beneficiary_status")
}

enum EvidenceType {
  PROOF_OF_PRESENCE
  CONSENT_RECORDING
  ID_DOCUMENT
  COMMUNITY_ATTESTATION
  NEEDS_ASSESSMENT_MEDIA
  OTHER

  @@map("evidence_type")
}

enum MediaVisibility {
  QUARANTINE
  RESTRICTED
  PUBLIC

  @@map("media_visibility")
}

// Why a file was uploaded. It decides the bucket (KYC documents never leave the restricted bucket)
// and where the file may be attached.
enum MediaPurpose {
  POST_MEDIA // photos and videos in a creator's post
  CONSENT_EVIDENCE // signed consent form or consent video for the person in the post
  KYC_DOCUMENT // government ID and selfie (restricted, deleted after the retention period)
  SPENDING_PROOF // receipts and item photos in a spending report
  VERIFICATION_EVIDENCE // field verification evidence captured by coordinators
  DISBURSEMENT_PROOF // proof attached to a platform payout

  @@map("media_purpose")
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_HUMAN

  @@map("moderation_status")
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  FUNDED
  UNDER_INVESTIGATION
  CLOSED
  CANCELLED

  @@map("campaign_status")
}

enum FundingType {
  FIXED // an exact goal for a specific need, e.g. a hospital bill; donations close when it is reached
  OPEN_ENDED // no goal, e.g. ongoing groceries; the creator reports spending as it happens

  @@map("funding_type")
}

// How the creator knows the person in the post. Shown publicly next to the creator's name.
enum CreatorRelationship {
  SELF
  FAMILY
  FRIEND_OR_NEIGHBOR
  COMMUNITY_WORKER // barangay worker, teacher, parish or NGO volunteer
  PASSERBY // met them in person, e.g. on the street, and asked them first
  OTHER

  @@map("creator_relationship")
}

enum SpendingProofKind {
  RECEIPT
  ITEM_PHOTO
  HANDOVER_PHOTO

  @@map("spending_proof_kind")
}

enum MilestoneStatus {
  PLANNED
  FUNDED
  DISBURSEMENT_REQUESTED
  DISBURSED
  PROOF_SUBMITTED
  PROOF_VERIFIED
  PROOF_OVERDUE

  @@map("milestone_status")
}

enum DonationStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED

  @@map("donation_status")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("refund_status")
}

enum PaymentProvider {
  PAYMONGO
  XENDIT
  STRIPE
  PAYPAL

  @@map("payment_provider")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE

  @@map("ledger_account_type")
}

enum EntryDirection {
  DEBIT
  CREDIT

  @@map("entry_direction")
}

enum LedgerTxnType {
  DONATION_CAPTURED
  PROCESSOR_FEE
  PLATFORM_FEE
  DISBURSEMENT
  REFUND
  CHARGEBACK
  CHARGEBACK_REVERSAL
  RESERVE_TRANSFER
  ADJUSTMENT

  @@map("ledger_txn_type")
}

enum DisbursementMethod {
  VENDOR_DIRECT
  BENEFICIARY_EWALLET
  BENEFICIARY_BANK
  COORDINATOR_PAYOUT
  CREATOR_PAYOUT // to the campaign's own KYC-verified creator only (DB trigger), who then posts receipts

  @@map("disbursement_method")
}

enum DisbursementStatus {
  REQUESTED
  APPROVED_L1
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELED
  RECONCILED

  @@map("disbursement_status")
}

enum ProofStatus {
  SUBMITTED
  AI_CHECKED
  VERIFIED
  REJECTED

  @@map("proof_status")
}

enum ActorType {
  USER
  SYSTEM
  AI

  @@map("actor_type")
}

// =====================================================================
// Identity
// =====================================================================

model User {
  id             String        @id @default(uuid(7)) @db.Uuid
  email          String?       @unique // stored lower-cased (DB CHECK users_email_lowercase)
  phoneE164      String?       @unique @map("phone_e164")
  displayName    String?       @map("display_name") // public name on posts, e.g. "Ana R."; checked against the ID
  roles          Role[]        @default([DONOR])
  status         AccountStatus @default(ACTIVE)
  mfaEnabled     Boolean       @default(false) @map("mfa_enabled")
  // KYC front gate: posting and payouts need VERIFIED and an unexpired kyc_expires_at (DB triggers).
  kycStatus      KycStatus     @default(UNVERIFIED) @map("kyc_status")
  kycVerifiedAt  DateTime?     @map("kyc_verified_at") @db.Timestamptz(3)
  kycExpiresAt   DateTime?     @map("kyc_expires_at") @db.Timestamptz(3) // re-verification due
  kycProviderRef String?       @map("kyc_provider_ref") // applicant id at a KYC vendor, when one is used
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  coordinatorProfile    CoordinatorProfile?
  submissions           Submission[]
  donations             Donation[]
  sessions              AuthSession[]
  identityVerifications IdentityVerification[]
  campaigns             Campaign[] // posts this user created
  spendingReports       SpendingReport[]

  @@index([kycStatus])
  @@map("users")
}

// Sign-in session. The opaque token is given to the client once; only its sha256 is stored.
model AuthSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// One-time code sent by SMS for phone sign-in. Only an HMAC of the code is stored.
model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  phoneE164  String    @map("phone_e164")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0) // DB CHECK: at most 5 wrong codes
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt])
  @@index([ip, createdAt])
  @@map("otp_challenges")
}

// One KYC attempt: a government ID (front, back) plus a selfie holding the ID and a one-time
// challenge code, reviewed by trust and safety staff (or a KYC vendor, recorded in provider/providerRef).
// Data minimization: the ID images are deleted after media_purge_after; the decision is kept.
model IdentityVerification {
  id              String              @id @default(uuid(7)) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  user            User                @relation(fields: [userId], references: [id])
  status          IdentityCheckStatus @default(SUBMITTED)
  provider        String              @default("MANUAL_REVIEW") // MANUAL_REVIEW, SUMSUB, VERIFF, ONFIDO, PERSONA
  providerRef     String?             @unique @map("provider_ref")
  idType          GovernmentIdType    @map("id_type")
  displayName     String              @map("display_name") // public name the user asked for; must match the ID
  challengeCode   String              @map("challenge_code") // must be readable in the selfie
  submittedAt     DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewerId      String?             @map("reviewer_id") @db.Uuid // DB CHECK: never the applicant
  decidedAt       DateTime?           @map("decided_at") @db.Timestamptz(3)
  rejectionReason String?             @map("rejection_reason") // BLURRY_PHOTO, ID_EXPIRED, NAME_MISMATCH, SELFIE_MISMATCH, CHALLENGE_MISSING, SUSPECTED_FRAUD, OTHER
  reviewNote      String?             @map("review_note") // internal
  idExpiresOn     DateTime?           @map("id_expires_on") @db.Date
  mediaPurgeAfter DateTime?           @map("media_purge_after") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents IdentityDocument[]

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
  @@map("identity_verifications")
}

model IdentityDocument {
  id             String               @id @default(uuid(7)) @db.Uuid
  verificationId String               @map("verification_id") @db.Uuid
  verification   IdentityVerification @relation(fields: [verificationId], references: [id])
  kind           KycDocumentKind
  mediaAssetId   String               @unique @map("media_asset_id") @db.Uuid
  mediaAsset     MediaAsset           @relation(fields: [mediaAssetId], references: [id])
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([verificationId, kind])
  @@map("identity_documents")
}

model Organization {
  id                 String    @id @default(uuid(7)) @db.Uuid
  legalName          String    @map("legal_name")
  registrationNumber String    @map("registration_number") // e.g. SEC registration number
  orgType            String    @map("org_type") // NGO, SOCIAL_WELFARE_OFFICE, FAITH_BASED, SCHOOL
  country            String    @default("PH") @db.Char(2)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  payoutAccountRef   String?   @map("payout_account_ref") // sub-account / connected account id at the provider
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  coordinators CoordinatorProfile[]
  campaigns    Campaign[]

  @@unique([country, registrationNumber])
  @@map("organizations")
}

model CoordinatorProfile {
  id                            String          @id @default(uuid(7)) @db.Uuid
  userId                        String          @unique @map("user_id") @db.Uuid
  user                          User            @relation(fields: [userId], references: [id])
  organizationId                String?         @map("organization_id") @db.Uuid
  organization                  Organization?   @relation(fields: [organizationId], references: [id])
  tier                          CoordinatorTier @default(TIER0_REGISTERED)
  languages                     String[] // e.g. ["fil", "ceb", "en"]
  serviceAreaLabel              String?         @map("service_area_label") // PostGIS polygon added in a later migration
  payoutAccountRef              String?         @map("payout_account_ref")
  payoutDetailsLockedUntil      DateTime?       @map("payout_details_locked_until") @db.Timestamptz(3) // 72h cool-off
  proofComplianceRate           Decimal?        @map("proof_compliance_rate") @db.Decimal(5, 4)
  maxActiveCampaigns            Int             @default(1) @map("max_active_campaigns")
  monthlyDisbursementLimitMinor BigInt          @default(0) @map("monthly_disbursement_limit_minor")
  suspendedAt                   DateTime?       @map("suspended_at") @db.Timestamptz(3)
  createdAt                     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  verificationCases VerificationCase[]
  campaigns         Campaign[]

  @@index([organizationId])
  @@map("coordinator_profiles")
}

// =====================================================================
// Beneficiaries (public profile + restricted PII vault)
// =====================================================================

model Beneficiary {
  id             String            @id @default(uuid(7)) @db.Uuid
  publicSlug     String            @unique @map("public_slug")
  publicAlias    String            @map("public_alias") // chosen with consent, e.g. "Lolo Ben"
  ageBand        String?           @map("age_band") // "70-79" instead of a birth date
  publicRegion   String            @map("public_region") // city/municipality only, never an exact location
  needCategories String[]          @map("need_categories")
  status         BeneficiaryStatus @default(ACTIVE)
  mergedIntoId   String?           @map("merged_into_id") @db.Uuid // duplicate-merge history
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  private           BeneficiaryPrivate?
  consents          ConsentRecord[]
  socialPosts       SocialPost[]
  campaigns         Campaign[]
  verificationCases VerificationCase[]

  @@map("beneficiaries")
}

// Restricted: every column except the key is encrypted by the application (KMS data key).
// Destroying the data key referenced by dataKeyRef crypto-shreds the record.
model BeneficiaryPrivate {
  beneficiaryId     String      @id @map("beneficiary_id") @db.Uuid
  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id])
  legalNameEnc      Bytes       @map("legal_name_enc")
  legalNameBlindIdx String?     @map("legal_name_blind_idx") // HMAC of the normalized name
  exactLocationEnc  Bytes?      @map("exact_location_enc")
  contactEnc        Bytes?      @map("contact_enc")
  idDocumentRefEnc  Bytes?      @map("id_document_ref_enc")
  guardianEnc       Bytes?      @map("guardian_enc")
  dataKeyRef        String      @map("data_key_ref")
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([legalNameBlindIdx])
  @@map("beneficiary_private")
}

model ConsentRecord {
  id               String      @id @default(uuid(7)) @db.Uuid
  beneficiaryId    String      @map("beneficiary_id") @db.Uuid
  beneficiary      Beneficiary @relation(fields: [beneficiaryId], references: [id])
  capturedByUserId String      @map("captured_by_user_id") @db.Uuid
  method           String // VIDEO, SIGNED_FORM, THUMBPRINT, GUARDIAN, SELF (the creator is the person helped)
  language         String // fil, ceb, ilo, hil, en ...
  scopes           String[] // PUBLIC_PHOTO, PUBLIC_STORY, FUNDRAISING, FACE_MATCHING
  evidenceMediaId  String?     @map("evidence_media_id") @db.Uuid
  capturedAt       DateTime    @map("captured_at") @db.Timestamptz(3)
  revokedAt        DateTime?   @map("revoked_at") @db.Timestamptz(3)

  @@index([beneficiaryId])
  @@map("consent_records")
}

// =====================================================================
// Media
// =====================================================================

model MediaAsset {
  id           String                       @id @default(uuid(7)) @db.Uuid
  uploaderId   String                       @map("uploader_id") @db.Uuid
  purpose      MediaPurpose
  visibility   MediaVisibility              @default(QUARANTINE)
  storageKey   String                       @unique @map("storage_key")
  mimeType     String                       @map("mime_type")
  byteSize     Int                          @map("byte_size")
  sha256       String
  pHash        String?                      @map("p_hash") // perceptual hash (hex)
  width        Int?
  height       Int?
  durationMs   Int?                         @map("duration_ms")
  exifStripped Boolean                      @default(false) @map("exif_stripped")
  malwareScan  String                       @default("PENDING") @map("malware_scan") // PENDING, CLEAN, INFECTED
  moderation   ModerationStatus             @default(PENDING)
  embedding    Unsupported("vector(1024)")? // pgvector; dimension must match the embedding model
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  evidence            VerificationEvidence[]
  proofs              DisbursementProof[]
  identityDocument    IdentityDocument?
  campaignMedia       CampaignMedia?
  spendingReportMedia SpendingReportMedia?

  @@index([sha256])
  @@index([pHash])
  @@index([uploaderId, createdAt])
  @@map("media_assets")
}

// =====================================================================
// Submissions and verification
// =====================================================================

model SocialPost {
  id               String                       @id @default(uuid(7)) @db.Uuid
  platform         Platform
  platformPostId   String                       @map("platform_post_id")
  canonicalUrl     String                       @map("canonical_url")
  authorHandle     String?                      @map("author_handle")
  authorPlatformId String?                      @map("author_platform_id")
  captionText      String?                      @map("caption_text")
  postedAt         DateTime?                    @map("posted_at") @db.Timestamptz(3)
  embedHtml        String?                      @map("embed_html")
  thumbnailPHash   String?                      @map("thumbnail_p_hash")
  embedding        Unsupported("vector(1024)")?
  isAvailable      Boolean                      @default(true) @map("is_available")
  lastCheckedAt    DateTime?                    @map("last_checked_at") @db.Timestamptz(3)
  creatorUserId    String?                      @map("creator_user_id") @db.Uuid // set when the original poster proves ownership (OAuth)
  creatorClaimedAt DateTime?                    @map("creator_claimed_at") @db.Timestamptz(3)
  beneficiaryId    String?                      @map("beneficiary_id") @db.Uuid
  beneficiary      Beneficiary?                 @relation(fields: [beneficiaryId], references: [id])
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  submissions Submission[]

  @@unique([platform, platformPostId])
  @@index([beneficiaryId])
  @@index([thumbnailPHash])
  @@map("social_posts")
}

model Submission {
  id              String           @id @default(uuid(7)) @db.Uuid
  trackingCode    String           @unique @map("tracking_code")
  submittedById   String           @map("submitted_by_id") @db.Uuid
  submittedBy     User             @relation(fields: [submittedById], references: [id])
  socialPostId    String           @map("social_post_id") @db.Uuid
  socialPost      SocialPost       @relation(fields: [socialPostId], references: [id])
  submitterNotes  String?          @map("submitter_notes")
  locationHint    String?          @map("location_hint")
  urgency         Int              @default(0) // 0 = none .. 3 = medical emergency (DB CHECK)
  status          SubmissionStatus @default(RECEIVED)
  aiRiskScore     Decimal?         @map("ai_risk_score") @db.Decimal(5, 4)
  aiSummary       Json?            @map("ai_summary")
  triagedById     String?          @map("triaged_by_id") @db.Uuid
  rejectionReason String?          @map("rejection_reason")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  verificationCase VerificationCase?

  @@index([status, urgency, createdAt])
  @@index([socialPostId])
  @@index([submittedById])
  @@map("submissions")
}

model VerificationCase {
  id                 String              @id @default(uuid(7)) @db.Uuid
  submissionId       String              @unique @map("submission_id") @db.Uuid
  submission         Submission          @relation(fields: [submissionId], references: [id])
  beneficiaryId      String?             @map("beneficiary_id") @db.Uuid
  beneficiary        Beneficiary?        @relation(fields: [beneficiaryId], references: [id])
  coordinatorId      String?             @map("coordinator_id") @db.Uuid
  coordinator        CoordinatorProfile? @relation(fields: [coordinatorId], references: [id])
  status             VerificationStatus  @default(OPEN)
  challengeCode      String?             @map("challenge_code") // one-time phrase that must appear in proof-of-presence media
  challengeExpiresAt DateTime?           @map("challenge_expires_at") @db.Timestamptz(3)
  dueAt              DateTime?           @map("due_at") @db.Timestamptz(3)
  fieldVisitAt       DateTime?           @map("field_visit_at") @db.Timestamptz(3)
  needsAssessment    Json?               @map("needs_assessment")
  firstReviewerId    String?             @map("first_reviewer_id") @db.Uuid
  secondReviewerId   String?             @map("second_reviewer_id") @db.Uuid // DB CHECK: differs from first reviewer
  decisionNotes      String?             @map("decision_notes")
  decidedAt          DateTime?           @map("decided_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  evidence VerificationEvidence[]

  @@index([status, dueAt])
  @@index([coordinatorId, status])
  @@index([beneficiaryId])
  @@map("verification_cases")
}

model VerificationEvidence {
  id                String           @id @default(uuid(7)) @db.Uuid
  caseId            String           @map("case_id") @db.Uuid
  case              VerificationCase @relation(fields: [caseId], references: [id])
  type              EvidenceType
  mediaAssetId      String           @map("media_asset_id") @db.Uuid
  mediaAsset        MediaAsset       @relation(fields: [mediaAssetId], references: [id])
  capturedAt        DateTime         @map("captured_at") @db.Timestamptz(3)
  captureLat        Decimal?         @map("capture_lat") @db.Decimal(9, 6)
  captureLng        Decimal?         @map("capture_lng") @db.Decimal(9, 6)
  deviceAttestation Json?            @map("device_attestation") // Play Integrity / App Attest verdict
  clientSha256      String           @map("client_sha256") // hash computed on-device at capture time
  aiChecks          Json?            @map("ai_checks") // challenge-code OCR, face similarity, AI-image signals
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([caseId])
  @@index([mediaAssetId])
  @@map("verification_evidence")
}

// =====================================================================
// Campaigns and milestones
// =====================================================================

// A campaign is a creator's post: photos/videos of a person in need, a caption (story), and how the
// money will be used (milestones). Database guarantees (migration 20260925000200):
//   - the creator must be KYC VERIFIED (and not expired) to insert a campaign or set it ACTIVE;
//   - creator_id never changes after insert;
//   - FIXED campaigns have goal_minor > 0, OPEN_ENDED campaigns have goal_minor NULL.
model Campaign {
  id                  String              @id @default(uuid(7)) @db.Uuid
  slug                String              @unique
  creatorId           String              @map("creator_id") @db.Uuid
  creator             User                @relation(fields: [creatorId], references: [id])
  creatorRelationship CreatorRelationship @map("creator_relationship")
  beneficiaryId       String              @map("beneficiary_id") @db.Uuid
  beneficiary         Beneficiary         @relation(fields: [beneficiaryId], references: [id])
  coordinatorId       String?             @map("coordinator_id") @db.Uuid // optional field verification on top
  coordinator         CoordinatorProfile? @relation(fields: [coordinatorId], references: [id])
  organizationId      String?             @map("organization_id") @db.Uuid
  organization        Organization?       @relation(fields: [organizationId], references: [id])
  title               String
  story               String // the post caption, in the creator's own words
  storyTranslations   Json?               @map("story_translations")
  fundingType         FundingType         @map("funding_type")
  currency            String              @default("PHP") @db.Char(3)
  goalMinor           BigInt?             @map("goal_minor") // FIXED: the exact goal. OPEN_ENDED: null.
  raisedMinor         BigInt              @default(0) @map("raised_minor") // projection of the ledger, never the source of truth
  status              CampaignStatus      @default(DRAFT)
  excessFundsPolicy   String              @map("excess_funds_policy")
  reviewNote          String?             @map("review_note") // shown to the creator when a post is not approved
  verifiedAt          DateTime?           @map("verified_at") @db.Timestamptz(3) // optional field verification
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(3)
  closesAt            DateTime?           @map("closes_at") @db.Timestamptz(3)
  version             Int                 @default(0) // optimistic locking
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  milestones      Milestone[]
  donations       Donation[]
  updates         CampaignUpdate[]
  disbursements   Disbursement[]
  ledgerAccounts  LedgerAccount[]
  media           CampaignMedia[]
  spendingReports SpendingReport[]

  @@index([status, publishedAt])
  @@index([creatorId, status])
  @@index([beneficiaryId])
  @@index([coordinatorId])
  @@index([organizationId])
  @@map("campaigns")
}

// Photos and videos in a post, in display order. A media asset belongs to one post only.
model CampaignMedia {
  id           String     @id @default(uuid(7)) @db.Uuid
  campaignId   String     @map("campaign_id") @db.Uuid
  campaign     Campaign   @relation(fields: [campaignId], references: [id])
  mediaAssetId String     @unique @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  position     Int // 1-based (DB CHECK)
  altText      String?    @map("alt_text") // description for screen readers
  showsMinor   Boolean    @default(false) @map("shows_minor") // faces of minors are blurred before publishing
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([campaignId, position])
  @@map("campaign_media")
}

// How the money will be used, as the creator planned it. For FIXED campaigns every item has a budget
// and the budgets add up to the goal; OPEN_ENDED items may have no budget.
model Milestone {
  id           String             @id @default(uuid(7)) @db.Uuid
  campaignId   String             @map("campaign_id") @db.Uuid
  campaign     Campaign           @relation(fields: [campaignId], references: [id])
  position     Int
  title        String
  description  String
  budgetMinor  BigInt?            @map("budget_minor") // null for open-ended plan items (DB CHECK > 0 when set)
  payoutMethod DisbursementMethod @map("payout_method")
  status       MilestoneStatus    @default(PLANNED)
  proofDueDays Int                @default(7) @map("proof_due_days")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  disbursements   Disbursement[]
  updates         CampaignUpdate[]
  spendingReports SpendingReport[]

  @@unique([campaignId, position])
  @@map("milestones")
}

// Creator-posted proof of spending: what was bought or paid, how much, when, and the receipts and
// photos that show it. Public on the campaign page and the public ledger page.
// Database guarantees (migration 20260925000200): the facts (everything except the review columns)
// can never be updated, rows can never be deleted, and reports form a hash chain per campaign
// (UNIQUE(campaign_id, prev_hash): no forks), so a receipt cannot be quietly rewritten.
model SpendingReport {
  id           String      @id @default(uuid(7)) @db.Uuid
  campaignId   String      @map("campaign_id") @db.Uuid
  campaign     Campaign    @relation(fields: [campaignId], references: [id])
  milestoneId  String?     @map("milestone_id") @db.Uuid
  milestone    Milestone?  @relation(fields: [milestoneId], references: [id])
  authorId     String      @map("author_id") @db.Uuid
  author       User        @relation(fields: [authorId], references: [id])
  title        String // e.g. "Gamot para sa isang buwan"
  note         String?
  amountMinor  BigInt      @map("amount_minor") // DB CHECK > 0
  currency     String      @default("PHP") @db.Char(3)
  spentOn      DateTime    @map("spent_on") @db.Date
  merchantName String?     @map("merchant_name")
  prevHash     String      @map("prev_hash") // "GENESIS" for a campaign's first report
  hash         String      @unique // sha256 over the canonical report content, its media hashes and prevHash
  status       ProofStatus @default(SUBMITTED)
  reviewedById String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  reviewNote   String?     @map("review_note") // public reason when a report is rejected
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  media SpendingReportMedia[]

  @@unique([campaignId, prevHash])
  @@index([campaignId, createdAt])
  @@index([status, createdAt])
  @@index([authorId])
  @@map("spending_reports")
}

model SpendingReportMedia {
  id           String            @id @default(uuid(7)) @db.Uuid
  reportId     String            @map("report_id") @db.Uuid
  report       SpendingReport    @relation(fields: [reportId], references: [id])
  mediaAssetId String            @unique @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset        @relation(fields: [mediaAssetId], references: [id])
  kind         SpendingProofKind
  position     Int
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([reportId, position])
  @@map("spending_report_media")
}

model CampaignUpdate {
  id            String           @id @default(uuid(7)) @db.Uuid
  campaignId    String           @map("campaign_id") @db.Uuid
  campaign      Campaign         @relation(fields: [campaignId], references: [id])
  milestoneId   String?          @map("milestone_id") @db.Uuid
  milestone     Milestone?       @relation(fields: [milestoneId], references: [id])
  authorId      String           @map("author_id") @db.Uuid
  body          String
  mediaAssetIds String[]         @map("media_asset_ids")
  moderation    ModerationStatus @default(PENDING)
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([campaignId, publishedAt])
  @@index([milestoneId])
  @@map("campaign_updates")
}

// =====================================================================
// Payments
// =====================================================================

model Donation {
  id                String          @id @default(uuid(7)) @db.Uuid
  campaignId        String          @map("campaign_id") @db.Uuid
  campaign          Campaign        @relation(fields: [campaignId], references: [id])
  donorUserId       String?         @map("donor_user_id") @db.Uuid
  donor             User?           @relation(fields: [donorUserId], references: [id])
  donorEmailHash    String?         @map("donor_email_hash") // guest lookup; raw contact data lives in a separate PII store
  displayName       String?         @map("display_name")
  isAnonymous       Boolean         @default(false) @map("is_anonymous")
  message           String?
  currency          String          @default("PHP") @db.Char(3)
  amountMinor       BigInt          @map("amount_minor") // allocated to the campaign (DB CHECK > 0)
  tipMinor          BigInt          @default(0) @map("tip_minor") // optional platform tip
  processorFeeMinor BigInt?         @map("processor_fee_minor") // known after settlement
  provider          PaymentProvider
  providerPaymentId String?         @unique @map("provider_payment_id")
  idempotencyKey    String          @unique @map("idempotency_key")
  status            DonationStatus  @default(PENDING)
  receiptNumber     String?         @unique @map("receipt_number")
  ledgerTxnId       String?         @map("ledger_txn_id") @db.Uuid
  riskScore         Decimal?        @map("risk_score") @db.Decimal(5, 4)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  refunds Refund[]

  @@index([campaignId, status, createdAt])
  @@index([donorUserId])
  @@map("donations")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  donationId       String       @map("donation_id") @db.Uuid
  donation         Donation     @relation(fields: [donationId], references: [id])
  amountMinor      BigInt       @map("amount_minor")
  reason           String // DONOR_REQUEST, CAMPAIGN_FRAUD, DUPLICATE, GOAL_EXCEEDED
  providerRefundId String?      @unique @map("provider_refund_id")
  status           RefundStatus @default(PENDING)
  initiatedById    String?      @map("initiated_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([donationId])
  @@map("refunds")
}

// Every inbound gateway webhook is stored exactly once. The unique (provider, provider_event_id)
// constraint is what makes duplicate deliveries harmless (see payment-webhook.service.ts).
model PaymentWebhookEvent {
  id              String          @id @default(uuid(7)) @db.Uuid
  provider        PaymentProvider
  providerEventId String          @map("provider_event_id")
  eventType       String          @map("event_type")
  livemode        Boolean         @default(false)
  payload         Json
  signatureValid  Boolean         @map("signature_valid")
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(3)
  attempts        Int             @default(0)
  lastError       String?         @map("last_error")

  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
  @@map("payment_webhook_events")
}

// =====================================================================
// Public ledger: append-only, double-entry, hash-chained
// =====================================================================

model LedgerAccount {
  id         String            @id @default(uuid(7)) @db.Uuid
  code       String            @unique // "campaign:<id>:held", "platform:fees", "provider:paymongo:clearing", "platform:reserve"
  type       LedgerAccountType
  currency   String            @default("PHP") @db.Char(3)
  campaignId String?           @map("campaign_id") @db.Uuid
  campaign   Campaign?         @relation(fields: [campaignId], references: [id])
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([campaignId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String        @id @default(uuid(7)) @db.Uuid
  seq            BigInt        @unique @default(autoincrement())
  type           LedgerTxnType
  referenceType  String        @map("reference_type") // DONATION, DISBURSEMENT, REFUND, DISPUTE, ADJUSTMENT
  referenceId    String        @map("reference_id")
  idempotencyKey String        @unique @map("idempotency_key")
  description    String
  occurredAt     DateTime      @map("occurred_at") @db.Timestamptz(3)
  chainKey       String        @map("chain_key") // the hash chain this transaction extends (usually a campaign id)
  prevHash       String        @map("prev_hash") // "GENESIS" for the first transaction of a chain
  hash           String        @unique // sha256 over the canonical transaction content + prevHash
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  // A chain can never fork: two transactions cannot extend the same predecessor.
  @@unique([chainKey, prevHash])
  @@index([chainKey, seq])
  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid(7)) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String            @map("account_id") @db.Uuid
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  direction     EntryDirection
  amountMinor   BigInt            @map("amount_minor") // always > 0 (DB CHECK); direction carries the sign
  currency      String            @db.Char(3)

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

// Daily Merkle root over all chain heads, signed and published for public verification.
model LedgerAnchor {
  id           String   @id @default(uuid(7)) @db.Uuid
  periodStart  DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd    DateTime @unique @map("period_end") @db.Timestamptz(3)
  merkleRoot   String   @map("merkle_root")
  chainHeads   Json     @map("chain_heads") // { chainKey: headHash }
  signature    String // KMS asymmetric signature over merkleRoot
  publishedUrl String?  @map("published_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("ledger_anchors")
}

// =====================================================================
// Disbursements (money out: maker-checker enforced by DB CHECKs)
// =====================================================================

model Disbursement {
  id               String             @id @default(uuid(7)) @db.Uuid
  campaignId       String             @map("campaign_id") @db.Uuid
  campaign         Campaign           @relation(fields: [campaignId], references: [id])
  milestoneId      String             @map("milestone_id") @db.Uuid
  milestone        Milestone          @relation(fields: [milestoneId], references: [id])
  method           DisbursementMethod
  payeeType        String             @map("payee_type") // VENDOR, BENEFICIARY, COORDINATOR, CREATOR
  payeeId          String             @map("payee_id") @db.Uuid
  currency         String             @default("PHP") @db.Char(3)
  amountMinor      BigInt             @map("amount_minor")
  status           DisbursementStatus @default(REQUESTED)
  requestedById    String             @map("requested_by_id") @db.Uuid
  approver1Id      String?            @map("approver1_id") @db.Uuid // DB CHECK: differs from requester
  approver2Id      String?            @map("approver2_id") @db.Uuid // DB CHECK: differs from requester and approver1
  idempotencyKey   String             @unique @map("idempotency_key")
  providerPayoutId String?            @unique @map("provider_payout_id")
  proofDueAt       DateTime?          @map("proof_due_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  proofs DisbursementProof[]

  @@index([campaignId, status])
  @@index([milestoneId])
  @@map("disbursements")
}

model DisbursementProof {
  id                String       @id @default(uuid(7)) @db.Uuid
  disbursementId    String       @map("disbursement_id") @db.Uuid
  disbursement      Disbursement @relation(fields: [disbursementId], references: [id])
  mediaAssetId      String       @map("media_asset_id") @db.Uuid
  mediaAsset        MediaAsset   @relation(fields: [mediaAssetId], references: [id])
  kind              String // RECEIPT, HANDOVER_PHOTO, BENEFICIARY_ACK
  ocrExtract        Json?        @map("ocr_extract")
  receiptTotalMinor BigInt?      @map("receipt_total_minor")
  aiFindings        Json?        @map("ai_findings")
  status            ProofStatus  @default(SUBMITTED)
  reviewedById      String?      @map("reviewed_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([disbursementId])
  @@index([mediaAssetId])
  @@map("disbursement_proofs")
}

// =====================================================================
// AI, audit, and messaging infrastructure
// =====================================================================

model AiInvocation {
  id            String   @id @default(uuid(7)) @db.Uuid
  feature       String // LINK_SCREEN, DUP_ADJUDICATE, RECEIPT_CHECK, STORY_DRAFT, CLAIM_CHECK
  model         String
  promptVersion String   @map("prompt_version")
  outcome       String // PARSED, REFUSED, INVALID_OUTPUT, ERROR, DISABLED
  output        Json?
  stopReason    String?  @map("stop_reason")
  latencyMs     Int      @map("latency_ms")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([feature, createdAt])
  @@index([targetType, targetId])
  @@map("ai_invocations")
}

// Append-only (DB trigger). Actor ids are plain columns so user deletion never breaks history.
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String // DISBURSEMENT_APPROVED, EVIDENCE_VIEWED, CAMPAIGN_PUBLISHED, ...
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?   @map("request_id")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Transactional outbox: written in the same DB transaction as the state change, relayed to SQS.
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  messageGroup  String?   @map("message_group") // SQS FIFO MessageGroupId, e.g. the campaign id
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, id])
  @@map("outbox_events")
}

// Consumer-side idempotency: one row per (consumer, message) that has been handled.
model ProcessedMessage {
  consumer    String
  messageId   String   @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId])
  @@map("processed_messages")
}
