{
  "name": "abotkamay",
  "version": "0.1.0",
  "private": true,
  "description": "AbotKamay: verified, transparent help for people in need, within reach.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  },
  "scripts": {
    "dev": "npm run start:dev -w @abotkamay/api",
    "build": "npm run build -w @abotkamay/api",
    "start": "npm run start:prod -w @abotkamay/api",
    "worker": "npm run start:worker -w @abotkamay/api",
    "dev:worker": "npm run dev:worker -w @abotkamay/api",
    "lint": "npm run lint -w @abotkamay/api",
    "format:check": "npm run format:check -w @abotkamay/api",
    "typecheck": "npm run typecheck -w @abotkamay/api",
    "test": "npm run test -w @abotkamay/api",
    "test:integration": "npm run test:integration -w @abotkamay/api",
    "db:generate": "npm run prisma:generate -w @abotkamay/api",
    "db:validate": "npm run prisma:validate -w @abotkamay/api",
    "db:migrate:dev": "npm run prisma:migrate:dev -w @abotkamay/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy -w @abotkamay/api",
    "db:migrate:status": "npm run prisma:migrate:status -w @abotkamay/api",
    "dev:web": "npm run dev -w @abotkamay/web",
    "build:web": "npm run build -w @abotkamay/web",
    "start:web": "npm run start -w @abotkamay/web",
    "lint:web": "npm run lint -w @abotkamay/web",
    "typecheck:web": "npm run typecheck -w @abotkamay/web",
    "format:check:web": "npm run format:check -w @abotkamay/web",
    "qa:compile": "cd qa/e2e-selenium && ./mvnw -B -q test-compile",
    "qa:e2e": "cd qa/e2e-selenium && ./mvnw -B verify"
  }
}
