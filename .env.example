# .env.example: copy to .env (repo root) and fill in. Never commit .env.

# ---------- Database (Neon PostgreSQL) ----------
# Runtime connection: use Neon's POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/abotkamay?sslmode=require"
# Migrations: use Neon's DIRECT (non-pooled) connection string. Falls back to DATABASE_URL if unset.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/abotkamay?sslmode=require"
# Max connections per API instance (keep low on Neon free/small computes).
DATABASE_POOL_MAX=10

# ---------- App ----------
NODE_ENV=development
PORT=4000
APP_NAME=AbotKamay
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:3000"

# ---------- Payment gateways (sandbox keys) ----------
# PayMongo: webhook secret shown when you create the webhook (whsk_...).
PAYMONGO_WEBHOOK_SECRET=
# Xendit: "Webhook verification token" from the Xendit dashboard.
XENDIT_CALLBACK_TOKEN=
# Stripe (optional, for international cards): API key + webhook signing secret (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Maximum age (seconds) accepted for signed webhook timestamps (replay protection).
WEBHOOK_TOLERANCE_SECONDS=300

# ---------- AI (Anthropic Claude) ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Set to "false" to route every submission to human review (AI kill switch).
AI_SCREENING_ENABLED=true

# ---------- Sign-in (phone + SMS one-time code) ----------
# 32+ random characters; keys the HMACs over one-time codes and KYC challenge codes.
# Required in staging and production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Shared with the web app's server (Vercel env FORWARDED_IP_SECRET, same value), which reports each
# visitor's IP address with it. Required in staging and production (32+ characters); leave empty locally.
FORWARDED_IP_SECRET=
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=300
# "log" prints one-time codes to the API log (development/test only; refused in staging/production).
# "none" makes sign-in answer 503 until a real SMS gateway adapter is configured.
SMS_PROVIDER=log

# ---------- Creator KYC ----------
# Verification lasts this long, or until the ID expires if that comes first.
KYC_REVERIFY_MONTHS=24
# ID and selfie images are deleted this many days after the reviewer's decision.
KYC_MEDIA_RETENTION_DAYS=30
# Open campaigns (in review, live, paused, funded, under investigation) allowed per creator.
CREATOR_MAX_OPEN_CAMPAIGNS=3

# ---------- Media storage (S3 or S3-compatible) ----------
# Browsers upload straight to storage with presigned PUT URLs (never through the API). Uploads answer
# 503 until the quarantine and restricted buckets are set. Credentials come from the standard AWS
# chain: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY (an R2 API token's keys work the same way).
# AWS S3:        MEDIA_S3_REGION=ap-southeast-1, MEDIA_S3_ENDPOINT empty, MEDIA_S3_FORCE_PATH_STYLE=false
# Cloudflare R2: MEDIA_S3_REGION=auto, MEDIA_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
#                MEDIA_S3_FORCE_PATH_STYLE=true (every bucket then shares one upload origin)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_S3_REGION=ap-southeast-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_FORCE_PATH_STYLE=false
# Post photos/videos, consent evidence and receipts land here first (never public).
MEDIA_QUARANTINE_BUCKET=
# Government IDs and selfies (default SSE-KMS encryption on AWS, never public).
MEDIA_RESTRICTED_BUCKET=
# Public copies made by the media worker (EXIF/GPS stripped, H.264 MP4, posters). Only the worker
# writes here; the CDN below serves it read-only.
MEDIA_PUBLIC_BUCKET=
# CDN origin serving the public bucket, e.g. https://media.abotkamay.ph (R2 custom domain or CloudFront).
MEDIA_PUBLIC_BASE_URL=

# ---------- Media worker (npm run worker; node dist/worker.js in production) ----------
# Seconds between queue polls when idle, and how many times a failing file is retried (3^n minutes apart)
# before it is held for a human.
MEDIA_WORKER_POLL_SECONDS=5
MEDIA_WORKER_MAX_ATTEMPTS=6
# Wall-clock limit for one ffmpeg run; a stuck encode is killed and retried later.
MEDIA_WORKER_FFMPEG_TIMEOUT_SECONDS=900
# Tool paths (the Docker image installs all three; set these when they are not on PATH locally).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HEIF_CONVERT_PATH=heif-convert
