# .gitignore (AbotKamay monorepo)

# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo

# Next.js (apps/web): build output and the generated type stub
.next/
out/
next-env.d.ts

# Prisma generated client (regenerated by `npm run db:generate` / postinstall)
apps/api/src/generated/

# Environment files: never commit secrets
.env
.env.*
!.env.example

# Java / Maven (QA suite)
qa/e2e-selenium/target/
qa/e2e-selenium/allure-results/
qa/e2e-selenium/allure-report/

# Logs and OS/editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
